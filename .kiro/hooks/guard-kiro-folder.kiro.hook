{
  "enabled": true,
  "name": "Keep .kiro committed",
  "description": "The hackathon requires the /.kiro folder at the repo root and not ignored by git.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      ".gitignore",
      "**/.gitignore"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A .gitignore changed. Run `git check-ignore -v .kiro .kiro/specs .kiro/steering .kiro/hooks .kiro/agents .kiro/settings/mcp.json`. If any path is ignored, show the matching rule and propose removing or narrowing it so .kiro is committed. Also confirm web/dist, node_modules and .graveyard/ are still ignored."
  }
}
