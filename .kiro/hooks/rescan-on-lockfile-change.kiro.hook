{
  "enabled": true,
  "name": "Rescan when a lockfile changes",
  "description": "A changed package-lock.json can add or remove zombies. Rescan that project and report what changed.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/package-lock.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A package-lock.json changed. Work out the project folder that contains it (skip anything under node_modules or .graveyard). Run `./bin/graveyard.mjs scan <that folder>` from the repo root, or call the graveyard_scan MCP tool with dir set to that folder. Report the zombie totals and list any zombie that is new or whose risk went up compared with the last scan you know of. Do not change any files."
  }
}
