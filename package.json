{
  "name": "graveyard-shift",
  "version": "0.1.0",
  "description": "The night crew that keeps dead dependencies alive: find abandoned npm packages, fix them with proof, and keep watch.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "graveyard": "./bin/graveyard.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "graveyard": "tsx src/cli.ts",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && tsx src/server/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "example:install": "npm install --prefix examples/haunted-app --no-audit --no-fund",
    "demo:record": "tsx scripts/record-demo.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-check": "^4.10.2",
    "tar": "^7.5.23",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
